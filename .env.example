# ---------------------------------------------------------------------------
# Wacaco Store - variables de entorno
# Copia este archivo como .env y completa los valores reales.
# En Coolify: pega estas claves en "Environment Variables" del servicio.
# ---------------------------------------------------------------------------

# --- Base de datos --------------------------------------------------------
# En docker-compose el host es el nombre del servicio ("db").
DATABASE_URL="postgresql://wacaco:wacaco_password@db:5432/wacaco?schema=public"
POSTGRES_USER="wacaco"
# IMPORTANTE: sin / + @ ? # ni espacios. La clave se inserta dentro de
# DATABASE_URL y esos caracteres rompen el parseo de la URL.
# Genera una segura con:  openssl rand -hex 32
POSTGRES_PASSWORD="cambia-esta-clave"
POSTGRES_DB="wacaco"

# --- Aplicación -----------------------------------------------------------
# URL pública completa (sin barra final). Mercado Pago la usa para volver
# a la tienda y para enviar los webhooks, por lo que DEBE ser https en producción.
APP_URL="https://tienda.tudominio.com"
NODE_ENV="production"
PORT="3000"

# Secreto para firmar las cookies de sesión (JWT).
# Genera uno con: openssl rand -base64 48
# (aqui si puede llevar cualquier caracter: no va dentro de una URL)
SESSION_SECRET="genera-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"

# --- Mercado Pago ---------------------------------------------------------
# Panel: https://www.mercadopago.com/developers/panel/app
# Access token de la aplicacion (de prueba mientras integras, luego el de
# produccion). Es la unica credencial de cobro que necesita la tienda:
# con Checkout Pro la public key solo haria falta si el navegador tokenizara
# tarjetas, y el client id/secret solo sirven para OAuth de marketplaces.
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx"
# Clave secreta del webhook (Panel > Webhooks > Configurar notificaciones).
# Sirve para validar la firma x-signature de cada notificación.
MP_WEBHOOK_SECRET="tu-clave-secreta-de-webhook"
# ARS, CLP, MXN, BRL, COP, PEN, UYU
MP_CURRENCY="CLP"
# Cuando es "true" se usa sandbox_init_point (credenciales de prueba).
MP_SANDBOX="false"

# --- Blue Express (cotizador de envios) -----------------------------------
# Credenciales que entrega el equipo de integraciones de Blue Express.
# Sin ellas la tienda cobra la tarifa plana de SHIPPING_FLAT_RATE.
BLUEX_API_KEY=""
BLUEX_TOKEN=""
# Codigo de distrito (comuna) desde donde despachas, en el formato de
# Blue Express. Te lo indican junto con las credenciales.
BLUEX_ORIGIN_DISTRICT=""
# Tipos de servicio a cotizar, separados por coma. Ej: "EX" o "EX,SD".
BLUEX_SERVICE_TYPES="EX"
# Familia de producto: PAQU (paquete) o DOCU (documento).
BLUEX_PRODUCT_FAMILY="PAQU"
# Solo cambiar si Blue Express indica otro host.
BLUEX_BASE_URL="https://apigw.bluex.cl"

# --- Tienda ---------------------------------------------------------------
STORE_NAME="Wacaco Store"
STORE_EMAIL="hola@tudominio.com"
# Envio gratis a partir de este monto (en la moneda de la tienda). 0 = desactivado.
FREE_SHIPPING_THRESHOLD="60000"
# Tarifa de respaldo cuando Blue Express no esta configurado o no responde.
SHIPPING_FLAT_RATE="4990"
# IVA/impuesto aplicado al subtotal, en porcentaje. 0 = precios ya incluyen impuesto.
TAX_RATE="0"

# --- Administrador inicial (se crea al ejecutar el seed) -------------------
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="cambia-esta-clave-ahora"
ADMIN_NAME="Administrador"
