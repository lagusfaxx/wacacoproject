// Wacaco Store - esquema de base de datos
// Todos los importes monetarios se guardan como Decimal(12,2) en la moneda
// configurada en la tienda (MP_CURRENCY). Nunca se confia en importes que
// vengan del cliente: los totales siempre se recalculan en el servidor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING // creada, esperando pago
  PAID // pago aprobado
  IN_PROCESS // pago en revision por Mercado Pago
  PREPARING // en preparacion en bodega
  SHIPPED // despachada
  DELIVERED // entregada
  CANCELLED // cancelada
  REFUNDED // reembolsada
  FAILED // pago rechazado
}

enum PaymentStatus {
  PENDING
  APPROVED
  AUTHORIZED
  IN_PROCESS
  IN_MEDIATION
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
}

enum DiscountType {
  PERCENT
  FIXED
}

/// Para que se pidio un codigo de un solo uso.
enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailStatus {
  /// Resend acepto el envio.
  SENT
  /// El proveedor rechazo el envio o la red fallo.
  FAILED
  /// No se intento: la tienda todavia no tiene el correo configurado.
  SKIPPED
}

// ---------------------------------------------------------------------------
// Clientes y autenticacion
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role      @default(CUSTOMER)
  emailVerified Boolean   @default(false)
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  carts     Cart[]
  auditLogs AuditLog[]

  @@index([role])
  @@index([createdAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("Principal")
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  region     String
  regionCode String?
  postalCode String
  country    String   @default("CL")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalogo
// ---------------------------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String?
  image       String?
  position    Int      @default(0)
  active      Boolean  @default(true)

  // --- SEO -----------------------------------------------------------------
  seoTitle       String?
  seoDescription String?
  seoImage       String?
  noIndex        Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]

  @@index([active, position])
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  subtitle       String?
  description    String   @default("")
  features       String[] @default([])
  specs          Json?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  sku            String   @unique
  stock          Int      @default(0)
  weightGrams    Int      @default(500)
  // Dimensiones del bulto en centimetros, usadas para cotizar el envio.
  lengthCm       Int      @default(20)
  widthCm        Int      @default(12)
  heightCm       Int      @default(12)
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  isNew          Boolean  @default(false)
  award          String?
  position       Int      @default(0)

  // --- SEO -----------------------------------------------------------------
  /// Titulo que se muestra en Google. Vacio = se usa el nombre del producto.
  seoTitle       String?
  /// Descripcion del resultado de busqueda. Vacio = subtitulo o descripcion.
  seoDescription String?
  /// Imagen para compartir en redes. Vacio = primera imagen del producto.
  seoImage       String?
  /// true pide a los buscadores no indexar la ficha y la excluye del sitemap.
  noIndex        Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images      ProductImage[]
  variants    ProductVariant[]
  blocks      ProductBlock[]
  collections ProductCollection[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([active, featured])
  @@index([active, position])
}

/// Bloque de contenido que se muestra bajo la ficha del producto.
///
/// Es la parte editorial de la pagina: la franja de fotos de uso, el relato de
/// marca sobre fondo oscuro y el video de presentacion. Cada producto arma su
/// propia secuencia desde el panel, sin tocar codigo.
///
/// `kind` decide que campos se usan y como se dibuja:
///   "gallery" -> `images` a lo ancho de la pantalla
///   "story"   -> `image` (logo), `title` y `body` centrados
///   "video"   -> `video` a lo ancho, con `image` de cartel
///   "split"   -> `image` a un costado y el texto al otro
model ProductBlock {
  id        String   @id @default(cuid())
  productId String
  kind      String   @default("story")
  eyebrow   String?
  title     String?
  body      String?
  /// Imagen unica del bloque: el logo del relato, el cartel del video o la
  /// fotografia del bloque partido.
  image     String?
  /// Fotografias de la franja. Solo lo usa "gallery".
  images    String[] @default([])
  /// Archivo directo (.mp4/.webm) o enlace de YouTube o Vimeo.
  video     String?
  /// Paleta del bloque: "dark" | "light" | "sand".
  theme     String   @default("dark")
  ctaLabel  String?
  ctaHref   String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String @default("")
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

/// Variante de color/version. `priceDelta` se suma al precio base del producto.
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  name       String
  colorHex   String?
  sku        String  @unique
  priceDelta Decimal @default(0) @db.Decimal(12, 2)
  stock      Int     @default(0)
  position   Int     @default(0)
  active     Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductCollection {
  productId    String
  collectionId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

// ---------------------------------------------------------------------------
// Carrito
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// ---------------------------------------------------------------------------
// Pedidos
// ---------------------------------------------------------------------------

model Order {
  id     String @id @default(cuid())
  /// Numero legible mostrado al cliente, ej. WC-2A4F91. Tambien se usa como
  /// external_reference en Mercado Pago.
  number String @unique

  userId String?
  email  String
  phone  String?

  status   OrderStatus @default(PENDING)
  currency String      @default("CLP")

  subtotal       Decimal @db.Decimal(12, 2)
  discountTotal  Decimal @default(0) @db.Decimal(12, 2)
  shippingTotal  Decimal @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  couponCode     String?

  // Direccion de envio congelada al momento de la compra.
  shipFullName   String
  shipPhone      String
  shipLine1      String
  shipLine2      String?
  shipCity       String
  shipRegion     String
  shipPostalCode String
  shipCountry    String  @default("CL")
  notes          String?

  /// Codigo ISO de la region (ej. CL-RM) y codigo de distrito de Blue Express.
  shipRegionCode   String?
  shipDistrictCode String?
  /// Transportista y servicio con los que se cotizo el envio.
  shipCarrier      String?
  shipServiceType  String?
  shipServiceName  String?
  shipPromiseDays  Int?

  /// Token aleatorio para que un invitado consulte su pedido sin cuenta.
  trackingToken String @unique

  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?

  // Snapshot: el pedido debe seguir siendo legible aunque el producto cambie.
  name        String
  variantName String?
  sku         String
  image       String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String

  provider String @default("mercadopago")
  /// id del pago en Mercado Pago (unico, garantiza idempotencia del webhook)
  externalId    String?       @unique
  preferenceId  String?
  status        PaymentStatus @default(PENDING)
  statusDetail  String?
  paymentType   String?
  paymentMethod String?
  installments  Int?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("CLP")
  payerEmail    String?
  /// Respuesta cruda del proveedor, util para soporte y conciliacion.
  raw           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

/// Linea de tiempo del pedido: cada cambio de estado deja huella.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    OrderStatus
  title     String
  message   String?
  /// true cuando el evento es visible para el cliente
  isPublic  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------------------
// Promociones y configuracion
// ---------------------------------------------------------------------------

/// Imagen subida desde el panel.
///
/// Se guarda en la base de datos y no en disco: el contenedor de Coolify es
/// efimero y cualquier archivo escrito en el sistema de archivos desaparece
/// en el siguiente despliegue. Se sirve por /api/media/<id>, que es cacheable
/// para siempre porque el id cambia con cada subida.
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  bytes     Bytes
  alt       String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Diapositiva del carrusel de la portada.
model Banner {
  id        String   @id @default(cuid())
  /// Donde se muestra: "hero" es el carrusel de la primera pantalla,
  /// "destacado" es la franja ancha que va bajo "Mas vendidos".
  placement String   @default("hero")
  eyebrow   String?
  title     String?
  subtitle  String?
  ctaLabel  String?
  ctaHref   String?
  image     String?
  /// Video de fondo. Manda sobre la imagen cuando esta presente: la imagen
  /// queda como cartel mientras el video carga. Admite un archivo directo
  /// (.mp4/.webm) o un enlace de YouTube o Vimeo.
  video     String?
  /// Como se coloca la imagen: "background" la usa a sangre completa,
  /// "side" la deja a un costado sobre el degradado.
  imageMode String   @default("background")
  /// Cuanto se oscurece la foto para que el texto blanco se lea:
  /// "none" | "soft" | "medium" | "strong".
  overlay   String   @default("medium")
  /// Degradado o color de fondo en CSS.
  background String?
  /// Muestra la bajada en negrita y sin transparencia, para cuando el texto
  /// queda poco legible sobre la foto.
  subtitleBold Boolean @default(false)
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
  @@index([placement, active, position])
}

/// Enlace del menu principal de la tienda.
model MenuItem {
  id       String  @id @default(cuid())
  label    String
  href     String
  position Int     @default(0)
  active   Boolean @default(true)

  @@index([active, position])
}

/// Tarifa de despacho definida a mano para una region.
///
/// Es la alternativa a cotizar con un courier: el propietario fija cuanto
/// cobra por region desde el panel. Se consulta cuando no hay integracion de
/// transportista disponible.
model ShippingRate {
  /// Codigo ISO de la region, ej. CL-RM. Una tarifa por region.
  regionCode String   @id
  price      Decimal  @db.Decimal(12, 2)
  /// Plazo estimado en dias habiles, informativo para el comprador.
  etaDays    Int?
  /// false = no se despacha a esa region.
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          DiscountType @default(PERCENT)
  value         Decimal      @db.Decimal(12, 2)
  minSubtotal   Decimal      @default(0) @db.Decimal(12, 2)
  maxRedemtions Int?
  timesRedeemed Int          @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

/// Clave/valor para ajustes editables desde el panel admin.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Contador simple para limitar intentos (login, checkout, webhook).
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Correo transaccional
// ---------------------------------------------------------------------------

/// Codigo de un solo uso enviado al correo del cliente.
///
/// Se guarda el hash y no el codigo: quien lea la base de datos (un respaldo,
/// un volcado de soporte) no puede usarlo para entrar en una cuenta ajena.
model VerificationCode {
  id         String              @id @default(cuid())
  email      String
  purpose    VerificationPurpose
  codeHash   String
  expiresAt  DateTime
  /// Intentos fallidos. Al llegar al maximo el codigo deja de servir, para que
  /// seis digitos no se puedan adivinar a fuerza bruta.
  attempts   Int                 @default(0)
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

/// Rastro de cada correo que la tienda intento enviar.
///
/// Sirve para soporte ("no me llego el comprobante") y para no repetir un
/// aviso cuando Mercado Pago reintenta la misma notificacion.
model EmailLog {
  id         String      @id @default(cuid())
  to         String
  subject    String
  /// Identificador de la plantilla, ej. "order.paid".
  type       String
  /// Clave de idempotencia, ej. "order:<id>:PAID". Vacia en los correos que
  /// si pueden repetirse, como el reenvio de un codigo.
  dedupeKey  String?     @unique
  status     EmailStatus @default(SENT)
  /// Id del envio en Resend, para buscarlo en su panel.
  providerId String?
  error      String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([to])
}
