# ---------------------------------------------------------------------------
# Wacaco Store - variables de entorno
# Copia este archivo como .env y completa los valores reales.
# En Coolify: pega estas claves en "Environment Variables" del servicio.
# ---------------------------------------------------------------------------

# --- Base de datos --------------------------------------------------------
# En docker-compose el host es el nombre del servicio ("db").
DATABASE_URL="postgresql://wacaco:wacaco_password@db:5432/wacaco?schema=public"
POSTGRES_USER="wacaco"
POSTGRES_PASSWORD="cambia-esta-clave"
POSTGRES_DB="wacaco"

# --- Aplicación -----------------------------------------------------------
# URL pública completa (sin barra final). Mercado Pago la usa para volver
# a la tienda y para enviar los webhooks, por lo que DEBE ser https en producción.
APP_URL="https://tienda.tudominio.com"
NODE_ENV="production"
PORT="3000"

# Secreto para firmar las cookies de sesión (JWT).
# Genera uno con: openssl rand -base64 48
SESSION_SECRET="genera-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"

# --- Mercado Pago ---------------------------------------------------------
# Panel: https://www.mercadopago.com/developers/panel/app
# Credenciales de producción (o de prueba mientras integras).
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx"
MP_PUBLIC_KEY="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Clave secreta del webhook (Panel > Webhooks > Configurar notificaciones).
# Sirve para validar la firma x-signature de cada notificación.
MP_WEBHOOK_SECRET="tu-clave-secreta-de-webhook"
# ARS, CLP, MXN, BRL, COP, PEN, UYU
MP_CURRENCY="CLP"
# Cuando es "true" se usa sandbox_init_point (credenciales de prueba).
MP_SANDBOX="false"

# --- Tienda ---------------------------------------------------------------
STORE_NAME="Wacaco Store"
STORE_EMAIL="hola@tudominio.com"
# Envío gratis a partir de este monto (en la moneda de la tienda). 0 = desactivado.
FREE_SHIPPING_THRESHOLD="60000"
SHIPPING_FLAT_RATE="4990"
# IVA/impuesto aplicado al subtotal, en porcentaje. 0 = precios ya incluyen impuesto.
TAX_RATE="0"

# --- Administrador inicial (se crea al ejecutar el seed) -------------------
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="cambia-esta-clave-ahora"
ADMIN_NAME="Administrador"
